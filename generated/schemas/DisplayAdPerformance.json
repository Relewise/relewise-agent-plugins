    },
    "timeSeries": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/DisplayAdPeriod"
      },
      "description": "Source time buckets ordered by start timestamp."
    },
    "displayAds": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/PromotedDisplayAd"
      },
      "description": "Per-creative promotion and click counts."
    }
  },
  "description": "Display Ad campaign performance."
}
