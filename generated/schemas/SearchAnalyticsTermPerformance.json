{
  "required": [
    "term",
    "searches",
    "clicks",
    "conversions"
  ],
  "type": "object",
  "properties": {
    "term": {
      "type": "string",
      "description": "Search term associated with these performance metrics."
    },
    "searches": {
      "allOf": [
        {
          "$ref": "#/components/schemas/ComparedValue"
        }
      ],
      "description": "Search-volume comparison for the term."
    },
    "clicks": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SearchClickMetrics"
        }
      ],
      "description": "Click-performance comparisons for the term."
    },
    "conversions": {
      "allOf": [
        {
          "$ref": "#/components/schemas/SearchConversionMetrics"
        }
      ],
      "description": "Conversion-performance comparisons for the term."
    }
  },
  "description": "One search term and its aggregate search, click, and conversion performance."
}
