{
  "required": [
    "productId",
    "variantId",
    "displayNames",
    "disabled",
    "assortments",
    "specifications",
    "listPrices",
    "salesPrices",
    "dataKeys",
    "dataValues",
    "dataValuesTruncated"
  ],
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "description": "ID of the parent Product."
    },
    "variantId": {
      "type": "string",
      "description": "ID within the parent Product."
    },
    "displayNames": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EntityDisplayName"
      },
      "description": "Available display names."
    },
    "disabled": {
      "type": "boolean",
      "description": "Whether it is disabled and therefore normally excluded from Search and Recommendations."
    },
    "assortments": {
      "type": "array",
      "items": {
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "format": "int32",
        "type": "integer"
      },
      "description": "Assortment values used by filters to control visibility. See https://docs.relewise.com/docs/filters/assortments.html."
    },
    "specifications": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/ProductVariantSpecification"
      },
      "description": "Specifications such as size or color."
    },
    "listPrices": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EntityPrice"
      },
      "description": "Stored list prices."
    },
    "salesPrices": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EntityPrice"
      },
      "description": "Stored sales prices."
    },
    "dataKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All Data Keys present."
    },
    "dataValues": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/EntityDataValue"
      },
      "description": "Up to 100 Data Values, selected by case-sensitive Data Key order. These are stored entity values, not Dataset metadata."
    },
    "dataValuesTruncated": {
      "type": "boolean",
      "description": "Whether DataValues contains fewer entries than DataKeys because Data Values are limited to 100."
    }
  },
  "description": "Stored details and Data Values for one Variant of a Product."
}
