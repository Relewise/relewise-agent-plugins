#!/usr/bin/env sh
set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
case "$script_dir" in
  [A-Za-z]:\\*)
    if command -v cygpath >/dev/null 2>&1; then
      script_dir="$(cygpath -u "$script_dir")"
    elif command -v wslpath >/dev/null 2>&1; then
      script_dir="$(wslpath -u "$script_dir")"
    fi
    ;;
esac

os="$(uname -s)"
arch="$(uname -m)"
case "$os:$arch" in
  MINGW*:*|MSYS*:*|CYGWIN*:*) runtime_id="win-x64"; executable="relewise-agent.exe" ;;
  Linux:x86_64|Linux:amd64) runtime_id="linux-x64"; executable="relewise-agent" ;;
  Linux:aarch64|Linux:arm64) runtime_id="linux-arm64"; executable="relewise-agent" ;;
  Darwin:x86_64|Darwin:amd64) runtime_id="osx-x64"; executable="relewise-agent" ;;
  Darwin:arm64|Darwin:aarch64) runtime_id="osx-arm64"; executable="relewise-agent" ;;
  *) echo "Unsupported platform: $os $arch" >&2; exit 3 ;;
esac

executable_path="$script_dir/libexec/$runtime_id/$executable"
if [ ! -f "$executable_path" ]; then
  echo "Relewise Agent executable not found for $runtime_id: $executable_path" >&2
  exit 3
fi
if [ ! -x "$executable_path" ]; then
  echo "Relewise Agent executable is not executable: $executable_path" >&2
  exit 3
fi

exec "$executable_path" "$@"
