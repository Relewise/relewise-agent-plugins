{
  "name": "relewise",
  "version": "0.4.2",
  "description": "Work with your Relewise configuration, analytics and optimization using AI.",
  "mcpServers": {
    "relewise-agent-gateway": {
      "httpUrl": "https://my.relewise.com/agents/mcp",
      "headers": {
        "Authorization": "Bearer ${RELEWISE_AGENT_GATEWAY_TOKEN:-}"
      },
      "env": {
        "RELEWISE_AGENT_GATEWAY_TOKEN": "${RELEWISE_AGENT_GATEWAY_TOKEN:-}"
      }
    }
  }
}
